<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Combos Fries</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=Figtree:wght@400;500;600;700&display=swap">
<style>
/* Layout: a single narrow "order slip" column, like a takeaway counter ticket. Tabs switch between customer ordering and the counter's loyalty book. */
:root{
  --bg:#fbf4ea;
  --paper:#ffffff;
  --ink:#141210;
  --muted:#6e6358;
  --line:#eadccb;
  --gold:#ff9a1f;
  --gold-ink:#1a0d00;
  --chilli:#e3640b;
  --ok:#2f7a3d;
  --display:"Bowlby One", "Arial Black", Impact, sans-serif;
  --body:"Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0d0c0b;--paper:#1a1816;--ink:#f6efe6;--muted:#a89b8c;--line:#2e2a26;
  --gold:#ff9a1f;--gold-ink:#1a0d00;--chilli:#ff8a2a;--ok:#6cc27b;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0d0c0b;--paper:#1a1816;--ink:#f6efe6;--muted:#a89b8c;--line:#2e2a26;
  --gold:#ff9a1f;--gold-ink:#1a0d00;--chilli:#ff8a2a;--ok:#6cc27b;color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 120px}
.wrap{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.hero{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.logo{width:clamp(120px,34vw,170px);height:auto;filter:drop-shadow(0 6px 14px rgb(0 0 0 / .25))}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.tag{font-family:var(--display);color:var(--chilli);letter-spacing:.06em;text-transform:uppercase;font-size:.95rem!important}
.sub{margin:4px 0 0;color:var(--muted);font-size:.9rem}
.brand{font-family:var(--display);font-size:clamp(2.2rem,9vw,3rem);line-height:.9;letter-spacing:.01em;margin:0}
.brand span{color:var(--chilli)}
.tag{margin:0}
.tabs{display:flex;gap:6px;background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:4px}
.tabs button{font:600 .9rem var(--body);border:0;background:none;color:var(--muted);padding:8px 14px;border-radius:999px;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--paper)}
button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}

.promo{background:var(--gold);color:var(--gold-ink);border-radius:14px;padding:14px 16px;display:flex;gap:14px;align-items:center}
.promo b{font-family:var(--display);font-weight:400;font-size:1.6rem;line-height:1}
.promo p{margin:0;font-size:.92rem}

h2{font-family:var(--display);font-weight:400;font-size:1.15rem;letter-spacing:.03em;text-transform:uppercase;margin:6px 0 0;color:var(--chilli)}
.menu{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:14px}
.item{display:grid;grid-template-columns:1fr auto;gap:4px 12px;padding:14px 16px;border-top:1px dashed var(--line);align-items:center}
.item:first-child{border-top:0}
.item .name{font-weight:700}
.item .desc:empty{display:none}
.sec{display:flex;align-items:center;gap:14px;margin-top:8px}
.sec img{width:76px;height:76px;border-radius:50%;box-shadow:0 0 0 3px var(--gold)}
.sec h2{margin:0}
.item .desc{color:var(--muted);font-size:.86rem;grid-column:1}
.item .price{font-variant-numeric:tabular-nums;font-weight:600;color:var(--muted);font-size:.9rem}
.qty{display:flex;align-items:center;gap:8px;grid-row:1/span 2;grid-column:2}
.qty button{width:36px;height:36px;border-radius:50%;border:1.5px solid var(--ink);background:none;color:var(--ink);font:700 1.1rem var(--body);cursor:pointer}
.qty button.add{background:var(--ink);color:var(--paper)}
.qty output{min-width:1.4em;text-align:center;font-weight:700;font-variant-numeric:tabular-nums}
.qty output.zero{color:var(--muted);font-weight:500}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips label{cursor:pointer}
.chips input{position:absolute;opacity:0;pointer-events:none}
.chips span{display:inline-block;padding:8px 14px;border-radius:999px;border:1.5px solid var(--line);background:var(--paper);font-weight:600;font-size:.9rem}
.chips input:checked+span{background:var(--chilli);border-color:var(--chilli);color:#fff}
.chips input:focus-visible+span{outline:3px solid var(--gold);outline-offset:2px}

.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fields .full{grid-column:1/-1}
label.f{display:flex;flex-direction:column;gap:4px;font-size:.82rem;font-weight:600;color:var(--muted)}
input[type=text],input[type=tel]{font:500 1rem var(--body);padding:11px 12px;border-radius:10px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);width:100%}
@media (max-width:420px){.fields{grid-template-columns:1fr}}

.bar{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:var(--paper);
  padding:12px max(16px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.bar .in{max-width:560px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px}
.bar .tot{font-variant-numeric:tabular-nums}
.bar .tot small{display:block;opacity:.7;font-size:.78rem}
.bar .tot strong{font-family:var(--display);font-weight:400;font-size:1.5rem}
.wa{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--gold-ink);text-decoration:none;font-weight:700;padding:12px 18px;border-radius:12px;white-space:nowrap}
.wa[aria-disabled="true"]{opacity:.45;pointer-events:none}
.note{font-size:.84rem;color:var(--muted);margin:0}
.btc-btn{align-self:flex-start;font:700 1rem var(--body);padding:13px 20px;border-radius:12px;border:0;background:#f7931a;color:#1a0d00;cursor:pointer}
.btc{background:var(--paper);border:2px solid #f7931a;border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:14px}
.btc-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.btc-top small{display:block;color:var(--muted);font-size:.8rem}
.btc-top strong{font-family:var(--display);font-weight:400;font-size:1.8rem;font-variant-numeric:tabular-nums}
.pill{background:#f7931a;color:#1a0d00;font-weight:700;font-size:.78rem;padding:4px 10px;border-radius:999px}
.qr{align-self:center;background:#fff;padding:10px;border-radius:10px;line-height:0}
.qr img{display:block;width:220px;max-width:100%;height:auto}
.steps{margin:0;padding-left:1.2em;display:flex;flex-direction:column;gap:4px;font-size:.92rem}
.addr{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.addr code{flex:1;min-width:0;overflow-wrap:anywhere;background:var(--bg);border:1px dashed var(--line);border-radius:8px;padding:10px;font-size:.92rem}
#btc-wallet{text-align:center;text-decoration:none}
.eft{border-color:var(--chilli)}
.eft-pill{background:var(--chilli);color:#fff}
.bank{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;margin:0;align-items:center}
.bank dt{color:var(--muted);font-size:.85rem}
.bank dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums;min-width:0;overflow-wrap:anywhere;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn.mini{padding:4px 10px;font-size:.8rem;border-radius:8px}
.slip{background:var(--paper);border:1px dashed var(--muted);border-radius:10px;padding:12px;white-space:pre-wrap;font-size:.88rem;font-family:ui-monospace,Menlo,monospace;overflow-wrap:anywhere}
.btn{font:600 .92rem var(--body);padding:10px 14px;border-radius:10px;border:1.5px solid var(--ink);background:none;color:var(--ink);cursor:pointer}
.btn.solid{background:var(--ink);color:var(--paper)}
.btn.gold{background:var(--gold);border-color:var(--gold);color:var(--gold-ink)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

/* loyalty */
.card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:14px}
.card h3{margin:0;font-size:1.15rem}
.stamps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;max-width:360px}
.stamp{aspect-ratio:1;max-width:100%;border-radius:50%;border:2px dashed var(--line);display:grid;place-items:center;font:400 .8rem var(--display);color:var(--muted)}
.stamp.on{border:0;background:var(--chilli);color:#fff;transform:rotate(-8deg)}
.stamp.free{border:2px solid var(--gold);color:var(--gold-ink);background:color-mix(in srgb,var(--gold) 25%,transparent)}
.stamp.free.ready{background:var(--gold)}
.ready-msg{background:var(--gold);color:var(--gold-ink);border-radius:10px;padding:10px 12px;font-weight:700}
.list{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:14px}
.list button{display:flex;justify-content:space-between;gap:12px;text-align:left;padding:12px 16px;background:none;border:0;border-top:1px solid var(--line);color:var(--ink);font:500 .95rem var(--body);cursor:pointer}
.list button:first-child{border-top:0}
.list .s{font-variant-numeric:tabular-nums;color:var(--muted);white-space:nowrap}
.empty{color:var(--muted);padding:14px 16px;margin:0;font-size:.9rem}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(90px + env(safe-area-inset-bottom,0px));background:var(--ok);color:#fff;padding:10px 16px;border-radius:10px;font-weight:600;z-index:20}
.warn{color:var(--chilli);font-weight:600}
@media (prefers-reduced-motion:no-preference){.stamp.on{transition:transform .2s}}
.status{display:inline-flex;align-items:center;gap:8px;margin:8px 0 0;font-weight:700;font-size:.88rem;padding:5px 12px;border-radius:999px;background:color-mix(in srgb,var(--ok) 15%,transparent);color:var(--ok)}
.status::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor}
.status.closed{background:color-mix(in srgb,var(--chilli) 14%,transparent);color:var(--chilli)}
.special{background:var(--ink);color:var(--paper);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:4px}
.special p{margin:0;font-weight:600}
.sp-tag{font-family:var(--display);color:var(--gold);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem}
.info{display:flex;flex-direction:column;gap:12px;border-top:2px dashed var(--line);padding-top:18px;margin-top:8px}
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px}
.info-grid>div{min-width:0;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.info h4,.sub-h{margin:0;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.info p{margin:0}
.hours-box{grid-column:1/-1}
.hours{border-collapse:collapse;font-variant-numeric:tabular-nums;width:100%;max-width:320px}
.hours td{padding:4px 0;border-bottom:1px solid var(--line)}
.hours td:last-child{text-align:right}
.hours tr.today td{font-weight:700;color:var(--chilli)}
.fine{font-size:.8rem;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.kpis div{background:var(--bg);border-radius:10px;padding:10px;min-width:0}
.kpis small{display:block;color:var(--muted);font-size:.75rem}
.kpis strong{font-family:var(--display);font-weight:400;font-size:1.3rem;font-variant-numeric:tabular-nums}
.kpis strong.sm{font-family:var(--body);font-weight:700;font-size:.85rem;line-height:1.2;display:block}
.paysplit{display:flex;flex-wrap:wrap;gap:6px;font-size:.85rem}
.paysplit span{background:var(--bg);border:1px solid var(--line);padding:4px 10px;border-radius:999px;font-variant-numeric:tabular-nums}
.tapgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.tapgrid button{font:600 .85rem var(--body);text-align:left;padding:10px;border-radius:10px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer;display:flex;flex-direction:column;gap:2px}
.tapgrid button small{color:var(--muted);font-weight:500}
.tapgrid button:active{border-color:var(--chilli)}
.cur{background:var(--bg);border-radius:10px;padding:10px 12px;font-size:.9rem;font-variant-numeric:tabular-nums}
.cur ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.cur li{display:flex;justify-content:space-between;gap:8px}
.cur .ctot{border-top:1px solid var(--line);margin-top:6px;padding-top:6px;font-weight:700}
.log{display:flex;flex-direction:column;font-size:.85rem;color:var(--muted);font-variant-numeric:tabular-nums}
.log div{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-top:1px solid var(--line)}
</style>

<div class="wrap">
  <header>
    <div class="hero">
      <img class="logo" src="data:image/webp;base64," alt="Combos Fries: Hot, Fresh, Delicious" width="240" height="240">
      <div>
        <h1 class="vh">Combos Fries</h1>
        <p class="tag">Hot · Fresh · Delicious</p>
        <p class="sub">Order ahead on WhatsApp. We deliver, or collect hot.</p>
        <p class="status" id="status" hidden></p>
      </div>
    </div>
    <div class="tabs" role="tablist">
      <button role="tab" id="tab-order" aria-selected="true">Order</button>
      <button role="tab" id="tab-loyalty" aria-selected="false">Loyalty</button>
    </div>
  </header>

  <!-- ORDER -->
  <section id="view-order" style="display:flex;flex-direction:column;gap:18px">
    <div class="special" id="special" hidden><span class="sp-tag" id="special-tag">Today's special</span><p id="special-text"></p></div>
    <div class="promo">
      <b>9th<br>free</b>
      <p>Buy 8 Wings &amp; Chips combos and your 9th combo is on us, any size. Add your cell number to your order and we'll stamp your card.</p>
    </div>

    <div class="sec"><img src="data:image/webp;base64," alt="Chicken wings on chips with sauce" width="120" height="120"><h2>Wings &amp; Chips</h2></div>
    <div class="menu" id="menu-wings"></div>
    <div class="sec"><img src="data:image/webp;base64," alt="Chips with tomato sauce and mayo" width="120" height="120"><h2>Chips</h2></div>
    <div class="menu" id="menu-chips"></div>

    <h2>Sauce &amp; salt</h2>
    <div class="chips" id="sauces"></div>

    <h2>Delivery or collect</h2>
    <div class="chips" id="mode">
      <label><input type="radio" name="mode" id="mode-collect" value="Collect" checked><span>Collect</span></label>
      <label><input type="radio" name="mode" id="mode-deliver" value="Delivery"><span>Deliver to me</span></label>
    </div>

    <h2>Your details</h2>
    <div class="fields">
      <div class="full chips" id="area-wrap" hidden>
        <label><input type="radio" name="area" id="area-tyoks" value="Tyoks" checked><span>Tyoks · R10</span></label>
        <label><input type="radio" name="area" id="area-other" value="Other"><span>Other area · R25</span></label>
      </div>
      <label class="f full" id="addr-wrap" hidden>Delivery address<input type="text" id="c-addr" autocomplete="street-address" placeholder="Street, house number, area"></label>
      <label class="f">Name<input type="text" id="c-name" autocomplete="name" placeholder="e.g. Sipho"></label>
      <label class="f">Cell (for loyalty)<input type="tel" id="c-phone" autocomplete="tel" placeholder="e.g. 072 123 4567"></label>
      <label class="f full">Time or note<input type="text" id="c-note" placeholder="e.g. Ready by 5:30, extra crispy"></label>
    </div>

    <h2>Payment</h2>
    <div class="chips" id="pay">
      <label><input type="radio" name="pay" id="pay-cash" value="Cash" checked><span>Cash</span></label>
      <label><input type="radio" name="pay" id="pay-btc" value="Bitcoin"><span>⚡ Bitcoin</span></label>
      <label><input type="radio" name="pay" id="pay-eft" value="EFT"><span>🏦 EFT</span></label>
    </div>
    <button class="btc-btn" id="btc-open" type="button">⚡ Pay with Bitcoin</button>
    <div class="btc" id="btc-panel" hidden>
      <div class="btc-top">
        <div><small>Amount to pay</small><strong id="btc-amt">R0</strong></div>
        <span class="pill">Lightning</span>
      </div>
      <div class="qr" id="btc-qr"><img src="data:image/png;base64," alt="Bitcoin Lightning QR code for nomsa@blink.sv" width="220" height="220"></div>
      <ol class="steps">
        <li>Open your Bitcoin Lightning wallet and scan the code, or paste our address.</li>
        <li>Enter the amount above in Rand. Your wallet converts it to sats.</li>
        <li>Send your order on WhatsApp. It shows you paid with Bitcoin.</li>
      </ol>
      <div class="addr"><code id="btc-addr"></code><button class="btn" id="btc-copy" type="button">Copy</button></div>
      <a class="btn solid" id="btc-wallet" href="#">Open my wallet</a>
    </div>
    <div class="btc eft" id="eft-panel" hidden>
      <div class="btc-top">
        <div><small>Amount to pay</small><strong id="eft-amt">R0</strong></div>
        <span class="pill eft-pill">EFT</span>
      </div>
      <dl class="bank">
        <dt>Bank</dt><dd>Capitec</dd>
        <dt>Account holder</dt><dd>LL Ndabambi</dd>
        <dt>Account number</dt><dd><span id="eft-acc">2439151889</span> <button class="btn mini" id="eft-copy" type="button">Copy</button></dd>
        <dt>Account type</dt><dd>Savings</dd>
        <dt>Branch code</dt><dd>470010</dd>
        <dt>Reference</dt><dd><strong id="eft-ref">Your name + cell</strong> <button class="btn mini" id="eft-ref-copy" type="button">Copy</button></dd>
      </dl>
      <p class="note">Use the reference above so we know it's your payment. Send your proof of payment with your WhatsApp order. We start frying once the payment shows.</p>
    </div>

    <h2>Your order message</h2>
    <div class="slip" id="slip">Add something from the menu to start your order.</div>
    <div class="row">
      <button class="btn" id="copy">Copy message</button>
      <span class="note">If WhatsApp doesn't open, copy this and send it to <b id="shop-num"></b>.</span>
    </div>

    <footer class="info" id="info">
      <h2>Find us</h2>
      <div class="info-grid">
        <div>
          <h4>Where</h4>
          <p id="loc-text"></p>
          <a class="btn" id="maps-link" href="#" target="_blank" rel="noopener" hidden>Open in Google Maps</a>
        </div>
        <div>
          <h4>WhatsApp</h4>
          <p><b>069 541 2295</b></p>
          <p class="note">Orders, delivery and questions</p>
        </div>
        <div class="hours-box">
          <h4>Trading hours</h4>
          <table class="hours" id="hours"></table>
        </div>
      </div>
      <p class="fine">Combos Fries · Hot · Fresh · Delicious · We accept cash, ⚡ Bitcoin and EFT</p>
    </footer>
  </section>

  <!-- LOYALTY (counter use) -->
  <section id="view-loyalty" hidden style="flex-direction:column;gap:18px">
    <div id="loy-off" class="card" hidden>
      <h3>Loyalty book</h3>
      <p class="note">The stamp book is for the Combos Fries counter. Ask at the counter how many stamps you have. Buy 8 Wings &amp; Chips combos and your 9th combo is free, any size.</p>
    </div>

    <div id="loy-on" hidden style="display:flex;flex-direction:column;gap:18px">
      <div class="card sales">
        <div class="row" style="justify-content:space-between">
          <h3>Today's sales</h3>
          <span class="note" id="s-date"></span>
        </div>
        <div class="kpis">
          <div><small>Total</small><strong id="s-total">R0</strong></div>
          <div><small>Sales</small><strong id="s-count">0</strong></div>
          <div><small>Best seller</small><strong id="s-best" class="sm">–</strong></div>
        </div>
        <div class="paysplit" id="s-pay"></div>

        <h4 class="sub-h">Ring up a sale</h4>
        <div class="tapgrid" id="s-items"></div>
        <div class="cur" id="s-cur"><p class="note">Tap items above to start a sale.</p></div>
        <div class="chips" id="s-paybox">
          <label><input type="radio" name="spay" id="spay-cash" value="cash" checked><span>Cash</span></label>
          <label><input type="radio" name="spay" id="spay-btc" value="btc"><span>⚡ Bitcoin</span></label>
          <label><input type="radio" name="spay" id="spay-eft" value="eft"><span>🏦 EFT</span></label>
        </div>
        <div class="row">
          <button class="btn solid" id="s-save" disabled>Save sale</button>
          <button class="btn" id="s-clear">Clear</button>
          <button class="btn" id="s-undo" disabled>Undo last sale</button>
        </div>
        <div class="log" id="s-log"></div>
      </div>

      <div class="card">
        <h3>Find a customer</h3>
        <div class="fields">
          <label class="f full">Cell number<input type="tel" id="l-phone" placeholder="072 123 4567"></label>
          <label class="f full">Name (for new customers)<input type="text" id="l-name" placeholder="optional"></label>
        </div>
        <div class="row"><button class="btn solid" id="l-find">Open card</button></div>
      </div>

      <div class="card" id="l-card" hidden>
        <div class="row" style="justify-content:space-between">
          <h3 id="l-title"></h3>
          <span class="note" id="l-meta"></span>
        </div>
        <div class="stamps" id="l-stamps"></div>
        <div class="ready-msg" id="l-ready" hidden>Free combo ready. Give it, then tap “Give free combo”.</div>
        <div class="row">
          <button class="btn solid" id="l-add">+ Stamp (combo bought)</button>
          <button class="btn" id="l-undo">Undo stamp</button>
          <button class="btn gold" id="l-redeem" hidden>Give free combo</button>
        </div>
      </div>

      <h2>Recent customers</h2>
      <div class="list" id="l-recent"><p class="empty">Loading the stamp book…</p></div>
    </div>
  </section>
</div>

<div class="bar" id="bar">
  <div class="in">
    <div class="tot"><small id="count">No items yet</small><strong id="total">R0</strong></div>
    <a class="wa" id="send" href="#" target="_blank" rel="noopener" aria-disabled="true">Send on WhatsApp</a>
  </div>
</div>
<div class="toast" id="toast" hidden></div>

<script>
/* ===== Shop settings: change these ===== */
const SHOP_WHATSAPP = "27695412295";   // your WhatsApp number in international format, no + or spaces
const STAMPS_FOR_FREE = 8;
/* Trading hours (SAMPLE until confirmed). 0 = Sunday ... 6 = Saturday. null = closed that day. */
const HOURS = {1:["11:00","20:00"],2:["11:00","20:00"],3:["11:00","20:00"],4:["11:00","20:00"],5:["11:00","21:00"],6:["10:00","21:00"],0:["12:00","18:00"]};
const LOCATION = "Tyoks";            // where you trade from
const MAPS_URL = "";                 // paste a Google Maps link here to show the map button
/* Specials: by weekday (0 = Sunday), or EVERYDAY for all days. Leave empty for none. */
const SPECIALS = {};                 // e.g. {5: "Friday: free peri mayo with every 6 wings & large chips"}
const EVERYDAY_SPECIAL = "";
const LIGHTNING_ADDRESS = "nomsa@blink.sv"; // your Lightning address (looks like an email)              // combos to earn a free one
/* Sample menu: swap in your real items and prices (Rand) */
const MENU = {
  wings:[
    {id:"w1",name:"2 wings & small chips",desc:"",price:38,combo:true},
    {id:"w2",name:"4 wings & medium chips",desc:"",price:50,combo:true},
    {id:"w3",name:"6 wings & large chips",desc:"",price:65,combo:true},
    {id:"w4",name:"8 wings & chips",desc:"",price:95,combo:true}
  ],
  chips:[
    {id:"s",name:"Small chips",desc:"",price:20},
    {id:"m",name:"Medium chips",desc:"",price:25},
    {id:"l",name:"Large chips",desc:"",price:35}
  ]
};
const SAUCES = ["BBQ sauce","Tomato sauce","Chip dip","Jalapeño","Peri mayo","Salt & vinegar","Spice"];
/* ======================================= */

const $ = s => document.querySelector(s);
const qty = {};
const all = [...MENU.wings,...MENU.chips];
const rand = n => "R" + n.toLocaleString("en-ZA");
const normPhone = v => { let d = String(v||"").replace(/\D/g,""); if (d.startsWith("0")) d = "27" + d.slice(1); return d; };
const showPhone = d => d.startsWith("27") && d.length === 11 ? "0"+d.slice(2,4)+" "+d.slice(4,7)+" "+d.slice(7) : d;

function renderMenu(key){
  const box = $("#menu-"+key);
  box.innerHTML = "";
  MENU[key].forEach(it=>{
    qty[it.id] ??= 0;
    const row = document.createElement("div");
    row.className = "item";
    row.innerHTML = `<div class="name"></div><div class="qty"><button aria-label="Remove one">−</button><output></output><button class="add" aria-label="Add one">+</button></div><div class="desc"></div>`;
    row.querySelector(".name").innerHTML = "";
    const nm = row.querySelector(".name"); nm.textContent = it.name + " ";
    const pr = document.createElement("span"); pr.className="price"; pr.textContent = "· " + rand(it.price); nm.append(pr);
    row.querySelector(".desc").textContent = it.desc;
    const out = row.querySelector("output");
    const sync = () => { out.textContent = qty[it.id]; out.classList.toggle("zero", !qty[it.id]); update(); };
    const [minus, plus] = row.querySelectorAll("button");
    minus.onclick = () => { qty[it.id] = Math.max(0, qty[it.id]-1); sync(); };
    plus.onclick = () => { qty[it.id]++; sync(); };
    out.textContent = qty[it.id]; out.classList.toggle("zero", !qty[it.id]);
    box.append(row);
  });
}
["wings","chips"].forEach(renderMenu);

const sauceBox = $("#sauces");
SAUCES.forEach((s,i)=>{
  const l = document.createElement("label");
  l.innerHTML = `<input type="checkbox" id="sauce-${i}"><span></span>`;
  l.querySelector("span").textContent = s;
  l.querySelector("input").onchange = update;
  sauceBox.append(l);
});
["#c-name","#c-phone","#c-note","#c-addr"].forEach(s=>$(s).addEventListener("input",update));
document.querySelectorAll('input[name="mode"]').forEach(r=>r.addEventListener("change",()=>{ $("#addr-wrap").hidden = $("#area-wrap").hidden = !$("#mode-deliver").checked; update(); }));
document.querySelectorAll('input[name="area"]').forEach(r=>r.addEventListener("change",update));
$("#shop-num").textContent = "069 541 2295";

function eftRef(){
  const n = $("#c-name").value.trim().split(/\s+/)[0].toUpperCase().replace(/[^A-Z0-9]/g,"");
  const p = $("#c-phone").value.replace(/\D/g,"");
  const ref = [n, p].filter(Boolean).join(" ");
  return ref || "Your name + cell";
}
function buildMessage(){
  const lines = all.filter(i=>qty[i.id]).map(i=>`${qty[i.id]} x ${i.name} — ${rand(i.price*qty[i.id])}`);
  if (!lines.length) return null;
  const deliver = $("#mode-deliver").checked, tyoks = $("#area-tyoks").checked;
  const fee = deliver ? (tyoks ? 10 : 25) : 0;
  if (fee) lines.push(`Delivery (${tyoks ? "Tyoks" : "other area"}) — ${rand(fee)}`);
  const total = all.reduce((t,i)=>t+i.price*qty[i.id],0) + fee;
  const combos = all.filter(i=>i.combo).reduce((t,i)=>t+qty[i.id],0);
  const sauces = SAUCES.filter((s,i)=>$("#sauce-"+i).checked);
  let m = "🍟 *COMBOS FRIES ORDER*\n\n" + lines.join("\n") + `\n\n*Total: ${rand(total)}*`;
  if (sauces.length) m += "\nSauce: " + sauces.join(", ");
  const name = $("#c-name").value.trim(), phone = $("#c-phone").value.trim(), note = $("#c-note").value.trim();
  if ($("#mode-deliver").checked){ const ad = $("#c-addr").value.trim(); m += "\n🚚 Delivery to: " + (ad || "(address to follow)"); }
  else m += "\n🏃 Collect";
  m += $("#pay-btc").checked ? "\n⚡ Paying with Bitcoin (Lightning)" : $("#pay-eft").checked ? "\n🏦 Paying by EFT (ref: " + eftRef() + "), proof of payment attached" : "\n💵 Paying cash";
  if (name) m += "\nName: " + name;
  if (phone) m += "\nCell: " + phone + (combos ? ` (stamp ${combos} combo${combos>1?"s":""} please)` : "");
  if (note) m += "\nNote: " + note;
  return {m,total,count:all.reduce((t,i)=>t+qty[i.id],0)};
}
function update(){
  const r = buildMessage(), send = $("#send");
  if (!r){
    $("#slip").textContent = "Add something from the menu to start your order.";
    $("#total").textContent = "R0"; $("#count").textContent = "No items yet";
    send.setAttribute("aria-disabled","true"); send.href = "#"; $("#btc-amt").textContent = "R0"; $("#eft-amt").textContent = "R0"; $("#eft-ref").textContent = eftRef(); return;
  }
  $("#slip").textContent = r.m;
  $("#total").textContent = rand(r.total);
  $("#btc-amt").textContent = rand(r.total);
  $("#eft-amt").textContent = rand(r.total);
  $("#eft-ref").textContent = eftRef();
  $("#count").textContent = r.count + (r.count===1?" item":" items");
  send.removeAttribute("aria-disabled");
  send.href = "https://wa.me/" + SHOP_WHATSAPP + "?text=" + encodeURIComponent(r.m);
}
update();

/* Hours, status, footer, specials */
const DAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
function saNow(){
  const p = Object.fromEntries(new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Johannesburg",weekday:"short",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).formatToParts(new Date()).map(x=>[x.type,x.value]));
  const day = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].indexOf(p.weekday);
  return {day, mins: (+p.hour)*60 + (+p.minute)};
}
const toMin = t => { const [h,m] = t.split(":").map(Number); return h*60+m; };
function renderStatus(){
  const {day, mins} = saNow(), h = HOURS[day], el = $("#status");
  let open = h && mins >= toMin(h[0]) && mins < toMin(h[1]);
  if (open){ el.textContent = "Open now · until " + h[1]; el.className = "status"; }
  else {
    let msg = "Closed now";
    if (h && mins < toMin(h[0])) msg += " · opens today " + h[0];
    else for (let i=1;i<=7;i++){ const d=(day+i)%7; if (HOURS[d]){ msg += " · opens " + (i===1?"tomorrow":DAYS[d]) + " " + HOURS[d][0]; break; } }
    el.textContent = msg; el.className = "status closed";
  }
  el.hidden = false;
  const send = $("#send"); send.textContent = open ? "Send on WhatsApp" : "Pre-order on WhatsApp";
  const rows = [1,2,3,4,5,6,0].map(d=>`<tr class="${d===day?"today":""}"><td>${DAYS[d]}</td><td>${HOURS[d] ? HOURS[d][0]+" – "+HOURS[d][1] : "Closed"}</td></tr>`).join("");
  $("#hours").innerHTML = rows;
  const sp = SPECIALS[day] || EVERYDAY_SPECIAL;
  $("#special").hidden = !sp; $("#special-text").textContent = sp || "";
  $("#special-tag").textContent = SPECIALS[day] ? DAYS[day] + " special" : "Special";
}
$("#loc-text").textContent = LOCATION + " · delivery available";
if (MAPS_URL){ $("#maps-link").href = MAPS_URL; $("#maps-link").hidden = false; }
renderStatus(); setInterval(renderStatus, 60000);

/* Bitcoin payment */
$("#btc-addr").textContent = LIGHTNING_ADDRESS;
$("#btc-wallet").href = "lightning:" + LIGHTNING_ADDRESS;
function showBtc(on){
  $("#btc-panel").hidden = !on;
  $("#btc-open").hidden = on;
  update();
}
$("#btc-open").onclick = () => { $("#pay-btc").checked = true; showBtc(true); $("#btc-panel").scrollIntoView({behavior:"smooth", block:"start"}); };
document.querySelectorAll('input[name="pay"]').forEach(r=>r.addEventListener("change",()=>{ $("#eft-panel").hidden = !$("#pay-eft").checked; showBtc($("#pay-btc").checked); }));
function copyText(text, node, msg){
  navigator.clipboard.writeText(text).then(()=>toast(msg)).catch(()=>{ const sel=getSelection(), rg=document.createRange(); rg.selectNodeContents(node); sel.removeAllRanges(); sel.addRange(rg); toast("Selected. Copy it now"); });
}
$("#eft-copy").onclick = () => copyText("2439151889", $("#eft-acc"), "Account number copied");
$("#eft-ref-copy").onclick = () => copyText(eftRef(), $("#eft-ref"), "Reference copied");
$("#btc-copy").onclick = async () => {
  try { await navigator.clipboard.writeText(LIGHTNING_ADDRESS); toast("Address copied"); }
  catch { const sel = getSelection(), rg = document.createRange(); rg.selectNodeContents($("#btc-addr")); sel.removeAllRanges(); sel.addRange(rg); toast("Selected. Copy it now"); }
};

$("#copy").onclick = async () => {
  const r = buildMessage(); if (!r) return;
  try { await navigator.clipboard.writeText(r.m); toast("Order copied"); }
  catch { const sel = getSelection(), rg = document.createRange(); rg.selectNodeContents($("#slip")); sel.removeAllRanges(); sel.addRange(rg); toast("Selected. Copy it now"); }
};

let toastT;
function toast(t){ const el=$("#toast"); el.textContent=t; el.hidden=false; clearTimeout(toastT); toastT=setTimeout(()=>el.hidden=true,1800); }

/* tabs */
function tab(which){
  const o = which==="order";
  $("#tab-order").setAttribute("aria-selected",o); $("#tab-loyalty").setAttribute("aria-selected",!o);
  $("#view-order").hidden = !o; $("#view-loyalty").hidden = o;
  $("#view-loyalty").style.display = o ? "" : "flex";
  $("#bar").hidden = !o;
}
$("#tab-order").onclick = () => tab("order");
$("#tab-loyalty").onclick = () => tab("loyalty");

/* ===== Loyalty book (counter only) ===== */
$("#loy-off").hidden = false;
let db = null, current = null, unsubCard = null, busy = false;

(async () => {
  try {
    const [d, user] = await Promise.all([claude.use("db"), claude.use("user")]);
    const canEdit = user ? await user.canEdit() : false;
    if (!d || !canEdit) return;
    db = d;
    $("#loy-off").hidden = true; $("#loy-on").hidden = false;
    $("#tab-loyalty").textContent = "Counter";
    initSales();
    db.collection("cards").orderBy("updatedAt","desc").limit(25).onSnapshot(renderRecent, () => {
      $("#l-recent").innerHTML = '<p class="empty warn">Could not load the stamp book. Reopen the page.</p>';
    });
  } catch (e) { /* stays in customer mode */ }
})();

function renderRecent(snap){
  const box = $("#l-recent");
  if (snap.empty){ box.innerHTML = '<p class="empty">No cards yet. Type a customer\'s cell number above and tap “Open card” to start one.</p>'; return; }
  box.innerHTML = "";
  snap.docs.forEach(doc=>{
    const c = doc.data(); const b = document.createElement("button");
    const l = document.createElement("span"); l.textContent = (c.name || "Customer") + " · " + showPhone(doc.id);
    const r = document.createElement("span"); r.className = "s"; r.textContent = `${c.stamps||0}/${STAMPS_FOR_FREE}` + (c.redeemed ? ` · ${c.redeemed} free` : "");
    b.append(l, r); b.onclick = () => { $("#l-phone").value = showPhone(doc.id); openCard(doc.id); };
    box.append(b);
  });
}

$("#l-find").onclick = () => {
  const p = normPhone($("#l-phone").value);
  if (p.length < 9){ toast("Enter a full cell number"); return; }
  openCard(p);
};

function openCard(phone){
  if (unsubCard) unsubCard();
  current = {phone, data:null};
  $("#l-card").hidden = false;
  $("#l-title").textContent = "Loading…";
  unsubCard = db.doc("cards/"+phone).onSnapshot(snap=>{
    current.data = snap.exists ? snap.data() : null;
    renderCard();
  }, () => { $("#l-title").textContent = "Could not load this card"; });
}

function renderCard(){
  const c = current.data || {}, n = c.stamps || 0, ready = n >= STAMPS_FOR_FREE;
  $("#l-title").textContent = (c.name || $("#l-name").value.trim() || "New customer") + " · " + showPhone(current.phone);
  $("#l-meta").textContent = current.data ? `${c.redeemed||0} free combos so far` : "New card";
  const box = $("#l-stamps"); box.innerHTML = "";
  for (let i=1;i<=STAMPS_FOR_FREE;i++){ const s=document.createElement("div"); s.className="stamp"+(i<=n?" on":""); s.textContent=i<=n?"🍟":i; box.append(s); }
  const f = document.createElement("div"); f.className = "stamp free" + (ready?" ready":""); f.textContent = "FREE"; box.append(f);
  $("#l-ready").hidden = !ready;
  $("#l-redeem").hidden = !ready;
  $("#l-add").disabled = ready;
  $("#l-undo").disabled = n === 0;
}

async function save(patch){
  if (busy || !current) return; busy = true;
  const base = current.data || {name: $("#l-name").value.trim(), stamps:0, redeemed:0, createdAt:new Date().toISOString()};
  const next = {...base, ...patch, updatedAt:new Date().toISOString()};
  if (!next.name) next.name = $("#l-name").value.trim();
  try { await db.doc("cards/"+current.phone).set(next); return true; }
  catch(e){ toast(e && e.code==="quota_exceeded" ? "Stamp book is full" : "Not saved. Try again"); return false; }
  finally { busy = false; }
}
$("#l-add").onclick = async () => { const n=(current?.data?.stamps||0); if (await save({stamps:Math.min(STAMPS_FOR_FREE,n+1)})) toast("Stamped"); };
$("#l-undo").onclick = async () => { const n=(current?.data?.stamps||0); if (n>0 && await save({stamps:n-1})) toast("Stamp removed"); };
$("#l-redeem").onclick = async () => { const c=current?.data||{}; if (await save({stamps:0, redeemed:(c.redeemed||0)+1})) toast("Free combo given. Card reset"); };

/* ===== Daily sales (counter only) ===== */
const PAY_LABEL = {cash:"Cash", btc:"⚡ Bitcoin", eft:"🏦 EFT"};
let today = null, dayData = null, cur = {}, savingSale = false;
const saDate = () => new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Johannesburg"}).format(new Date());
const curTotal = () => all.reduce((t,i)=>t+(cur[i.id]||0)*i.price,0);
function initSales(){
  const box = $("#s-items");
  all.forEach(it=>{
    const b = document.createElement("button"); b.type="button";
    const n = document.createElement("span"); n.textContent = it.name;
    const p = document.createElement("small"); p.textContent = rand(it.price);
    b.append(n,p); b.onclick = () => { cur[it.id]=(cur[it.id]||0)+1; renderCur(); };
    box.append(b);
  });
  $("#s-clear").onclick = () => { cur = {}; renderCur(); };
  $("#s-save").onclick = saveSale;
  $("#s-undo").onclick = undoSale;
  subscribeDay();
  setInterval(()=>{ if (saDate()!==today) subscribeDay(); }, 60000);
  renderCur();
}
let unsubDay = null;
function subscribeDay(){
  if (unsubDay) unsubDay();
  today = saDate(); dayData = null;
  $("#s-date").textContent = new Intl.DateTimeFormat("en-ZA",{timeZone:"Africa/Johannesburg",weekday:"short",day:"numeric",month:"short"}).format(new Date());
  unsubDay = db.doc("sales/"+today).onSnapshot(snap=>{ dayData = snap.exists ? snap.data() : null; renderDay(); },
    () => { $("#s-pay").innerHTML = '<span class="warn">Could not load today\'s sales. Reopen the page.</span>'; });
}
function renderCur(){
  const ids = all.filter(i=>cur[i.id]);
  const box = $("#s-cur");
  if (!ids.length){ box.innerHTML = '<p class="note">Tap items above to start a sale.</p>'; $("#s-save").disabled = true; return; }
  const ul = document.createElement("ul");
  ids.forEach(i=>{ const li=document.createElement("li"); const a=document.createElement("span"); a.textContent=cur[i.id]+" × "+i.name; const b=document.createElement("span"); b.textContent=rand(cur[i.id]*i.price); li.append(a,b); ul.append(li); });
  const t = document.createElement("li"); t.className="ctot"; t.innerHTML = "<span>Sale total</span><span></span>"; t.lastChild.textContent = rand(curTotal()); ul.append(t);
  box.innerHTML = ""; box.append(ul); $("#s-save").disabled = false;
}
function renderDay(){
  const d = dayData || {total:0,count:0,items:{},pay:{}};
  $("#s-total").textContent = rand(d.total||0);
  $("#s-count").textContent = d.count||0;
  const best = Object.entries(d.items||{}).sort((a,b)=>b[1]-a[1])[0];
  const bi = best && all.find(i=>i.id===best[0]);
  $("#s-best").textContent = bi ? bi.name + " (" + best[1] + ")" : "–";
  const pay = $("#s-pay"); pay.innerHTML = "";
  ["cash","btc","eft"].forEach(k=>{ const sp=document.createElement("span"); sp.textContent = PAY_LABEL[k] + " " + rand((d.pay||{})[k]||0); pay.append(sp); });
  const log = $("#s-log"); log.innerHTML = "";
  (d.log||[]).slice(-5).reverse().forEach(e=>{
    const row=document.createElement("div"); const a=document.createElement("span"); const b=document.createElement("span");
    a.textContent = e.time + " · " + Object.entries(e.items).map(([id,q])=>q+"× "+((all.find(i=>i.id===id)||{}).name||id)).join(", ");
    b.textContent = rand(e.total) + " " + (PAY_LABEL[e.pay]||"");
    row.append(a,b); log.append(row);
  });
  $("#s-undo").disabled = !(d.log||[]).length;
}
async function writeDay(next){
  if (savingSale) return false; savingSale = true;
  try { await db.doc("sales/"+today).set(next); return true; }
  catch(e){ toast(e && e.code==="quota_exceeded" ? "Sales book is full" : "Not saved. Try again"); return false; }
  finally { savingSale = false; }
}
async function saveSale(){
  const total = curTotal(); if (!total) return;
  const pay = document.querySelector('input[name="spay"]:checked').value;
  const d = dayData ? structuredClone(dayData) : {date:today,total:0,count:0,items:{},pay:{},log:[]};
  d.total = (d.total||0) + total; d.count = (d.count||0) + 1;
  d.items = d.items||{}; d.pay = d.pay||{}; d.log = d.log||[];
  for (const [id,q] of Object.entries(cur)) d.items[id] = (d.items[id]||0) + q;
  d.pay[pay] = (d.pay[pay]||0) + total;
  const time = new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Johannesburg",hour:"2-digit",minute:"2-digit"}).format(new Date());
  d.log.push({time, items:{...cur}, total, pay});
  if (d.log.length > 400) d.log = d.log.slice(-400);
  if (await writeDay(d)){ cur = {}; renderCur(); toast("Sale saved · " + rand(total)); }
}
async function undoSale(){
  if (!dayData || !(dayData.log||[]).length) return;
  const d = structuredClone(dayData); const e = d.log.pop();
  d.total -= e.total; d.count -= 1; d.pay[e.pay] = (d.pay[e.pay]||0) - e.total;
  for (const [id,q] of Object.entries(e.items)){ d.items[id] = (d.items[id]||0) - q; if (d.items[id] <= 0) delete d.items[id]; }
  if (await writeDay(d)) toast("Last sale removed");
}
</script>

</body></html>
